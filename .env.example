# このNuxtアプリ自体はランタイムの環境変数(process.env / runtimeConfig)を
# 使用していないため、ローカル開発に .env は不要です。
#
# 以下は GitHub Actions のデプロイ/診断ワークフロー
# (.github/workflows/deploy.yml, diagnose.yml, setup-glovertech-domain.yml)
# が使用する リポジトリシークレット の一覧です。.env ファイルとして
# 読み込まれるわけではなく、GitHub の Settings > Secrets and variables > Actions
# に登録してください。値はすべてダミーです。

VPS_HOST=203.0.113.10
VPS_USER=deploy
VPS_PASSWORD=changeme
VPS_PORT=22
